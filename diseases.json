      "specific_confirmatory_diagnostic_tests": [
        {
          "test_name": "low_dose_dexamethasone_suppression_test",
          "test_sensitivity_decimal": 0.925,
          "test_specificity_decimal": 0.585,
          "textbook_diagnostic_criteria_summary": "Plasma cortisol is measured before, 4-, and 8-hours after IV administration of 0.01 mg/kg dexamethasone. Cortisol above laboratory cut-off (1 or 1.4 mcg/dL) at 8-hours post-dexamethasone confirms hypercortisolism. Suppression of >50% from basal at 4 or 8-hours is compatible with PDH."
        },
        {
          "test_name": "urinary_cortisol_to_creatinine_ratio",
          "test_sensitivity_decimal": 0.875,
          "test_specificity_decimal": 0.225,
          "textbook_diagnostic_criteria_summary": "Integrated measure of corticoid production performed on 2 consecutive morning urine samples collected at home. Useful combined with oral HDDST to diagnose and discriminate pituitary from adrenal sources."
        },
        {
          "test_name": "acth_stimulation_test",
          "test_sensitivity_decimal": 0.7,
          "test_specificity_decimal": 0.76,
          "textbook_diagnostic_criteria_summary": "Plasma cortisol is measured before and 1 hour after administration of synthetic ACTH (5 mcg/kg IV or IM). Screens for hypercortisolism based on excessive cortisol response but does not differentiate pituitary from adrenal dependent disease."
        },
        {
          "test_name": "endogenous_acth_concentration",
          "test_sensitivity_decimal": 0.0,
          "test_specificity_decimal": 0.0,
          "textbook_diagnostic_criteria_summary": "Most accurate stand-alone biochemical test for discriminating pituitary from adrenal origin in dogs with proven hypercortisolism. Low or undetectable concentrations are expected in adrenal-dependent cases. Strict handling requires chilled tubes and immediate freezing."
        },
        {
          "test_name": "high_dose_dexamethasone_suppression_test",
          "test_sensitivity_decimal": 0.0,
          "test_specificity_decimal": 0.0,
          "textbook_diagnostic_criteria_summary": "Used to help differentiate pituitary from adrenal hypercortisolism when LDDST demonstrates no suppression. Given as 0.1 mg/kg IV dexamethasone. >50% suppression indicates pituitary origin, but it provides differentiation in only 12% additional dogs over LDDST and is generally no longer recommended over imaging."
        }
      ]
    },
